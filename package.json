{
  "name": "bse-trade-intelligence",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "backend": "npm --workspace backend run dev",
    "frontend": "npm --workspace frontend run dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "npm --workspace frontend run build",
    "test": "npm --workspace backend run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
